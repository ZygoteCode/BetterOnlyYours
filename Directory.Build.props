<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>latest</AnalysisLevel>
    <Company>OnlyYours</Company>
    <Product>OnlyYours</Product>
    <Authors>OnlyYours</Authors>
    <Copyright>© 2026 OnlyYours</Copyright>
    <Version>1.0.0</Version>
    <NeutralLanguage>it</NeutralLanguage>
    <SatelliteResourceLanguages>en;it</SatelliteResourceLanguages>
    <!-- PQC APIs (ML-KEM / ML-DSA) may still carry the experimental diagnostic. -->
    <NoWarn>$(NoWarn);SYSLIB5006;CA1416</NoWarn>
  </PropertyGroup>
</Project>
