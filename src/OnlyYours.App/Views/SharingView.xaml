<UserControl x:Class="OnlyYours.App.Views.SharingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OnlyYours.App.Controls"
             xmlns:vm="clr-namespace:OnlyYours.App.ViewModels"
             AutomationProperties.AutomationId="SharingView">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Pad.Page}" MaxWidth="1000">
            <TextBlock Text="{DynamicResource Sharing.Title}" Style="{StaticResource Text.Hero}" c:Anim.Enter="Rise" />
            <TextBlock Text="{DynamicResource Sharing.Subtitle}" Style="{StaticResource Text.Muted}" Margin="0,6,0,22" c:Anim.Enter="Rise" c:Anim.Delay="60" />

            <Border Background="{DynamicResource Brush.WarningSoft}" CornerRadius="12" Padding="14,10" Margin="0,0,0,16" Visibility="{Binding IsSupported, Converter={StaticResource Hidden}}">
                <TextBlock Text="{DynamicResource Sharing.Unsupported}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" />
            </Border>

            <!-- Identity -->
            <Border Style="{StaticResource Card}" Padding="24,22" c:Anim.Enter="Rise" c:Anim.Delay="100">
                <Grid>
                    <StackPanel Visibility="{Binding NeedsIdentity, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <c:Glyph Data="{DynamicResource Icon.Atom}" Width="26" Height="26" Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Text="{DynamicResource Sharing.NoIdentity}" Style="{StaticResource Text.Subtitle}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Sharing.NoIdentityDesc}" Style="{StaticResource Text.Muted}" Margin="0,10,0,16" />
                        <Button Style="{StaticResource Button.Primary}" c:Hint.Icon="{DynamicResource Icon.Sparkle}" Content="{DynamicResource Sharing.CreateIdentity}" Command="{Binding CreateIdentityCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="CreateIdentityButton" />
                    </StackPanel>
                    <Grid Visibility="{Binding HasIdentity, Converter={StaticResource Visible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:SealIdenticon Fingerprint="{Binding FingerprintBytes}" Width="112" Height="112" c:Anim.Enter="Pop" />
                        <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Sharing.YourIdentity}" Style="{StaticResource Text.Overline}" />
                            <TextBlock Text="{Binding IdentityName}" Style="{StaticResource Text.Title}" />
                            <TextBlock Text="{Binding Fingerprint}" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.TextAccent}" Margin="0,6,0,0" FontSize="13.5" AutomationProperties.AutomationId="Fingerprint" />
                            <TextBlock Text="{DynamicResource Sharing.Algorithms}" Style="{StaticResource Text.Caption}" Margin="0,4,0,12" TextWrapping="Wrap" />
                            <WrapPanel>
                                <Button Style="{StaticResource Button.Secondary}" c:Hint.Icon="{DynamicResource Icon.Copy}" Content="{DynamicResource Sharing.CopyId}" Command="{Binding CopyIdCommand}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource Button.Secondary}" c:Hint.Icon="{DynamicResource Icon.Export}" Content="{DynamicResource Sharing.SaveId}" Command="{Binding SaveIdCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Actions -->
            <UniformGrid Columns="2" Margin="0,18,0,0" c:Anim.Enter="Rise" c:Anim.Delay="160">
                <Button Style="{StaticResource Button.Card}" Command="{Binding ShareCommand}" Margin="0,0,8,0" IsEnabled="{Binding HasIdentity}">
                    <StackPanel Orientation="Horizontal">
                        <c:Glyph Data="{DynamicResource Icon.Share}" Width="22" Height="22" Foreground="{DynamicResource Brush.Accent}" />
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock Text="{DynamicResource Sharing.Share}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Sharing.ShareDesc}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxWidth="300" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Card}" Command="{Binding OpenPackageCommand}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <c:Glyph Data="{DynamicResource Icon.Package}" Width="22" Height="22" Foreground="{DynamicResource Brush.Accent}" />
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock Text="{DynamicResource Sharing.Open}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Sharing.OpenDesc}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxWidth="300" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Contacts -->
            <Grid Margin="0,26,0,12">
                <TextBlock Text="{DynamicResource Sharing.Contacts}" Style="{StaticResource Text.Subtitle}" />
                <Button Style="{StaticResource Button.Secondary}" c:Hint.Icon="{DynamicResource Icon.Plus}" Content="{DynamicResource Sharing.AddContact}" Command="{Binding AddContactCommand}" HorizontalAlignment="Right" />
            </Grid>
            <Border Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <TextBlock Text="{DynamicResource Sharing.NoContacts}" Style="{StaticResource Text.Caption}" Margin="12" Visibility="{Binding HasContacts, Converter={StaticResource Hidden}}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Contacts}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ContactViewModel}">
                                <Grid Margin="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <c:SealIdenticon Fingerprint="{Binding FingerprintBytes}" Width="44" Height="44" />
                                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="6,1" Background="{DynamicResource Brush.SuccessSoft}" Visibility="{Binding Verified, Converter={StaticResource Visible}}">
                                                <TextBlock Text="{DynamicResource Sharing.Verified}" FontSize="11" Foreground="{DynamicResource Brush.Success}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Fingerprint}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Style="{StaticResource Button.Icon}" c:Hint.Icon="{DynamicResource Icon.ShieldCheck}" Command="{Binding VerifyCommand}" ToolTip="{DynamicResource Sharing.ToggleVerified}" />
                                        <Button Style="{StaticResource Button.Icon}" c:Hint.Icon="{DynamicResource Icon.Trash}" c:Hint.Tone="danger" Command="{Binding RemoveCommand}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
