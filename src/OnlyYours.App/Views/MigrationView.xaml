<UserControl x:Class="OnlyYours.App.Views.MigrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OnlyYours.App.Controls"
             AutomationProperties.AutomationId="MigrationView">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,44,0,0">
            <Grid MinHeight="620">
                <Border Style="{StaticResource Card}" Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36,32" Margin="0,10,0,30" c:Anim.Enter="Rise">
                    <StackPanel>
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="54" Height="54" CornerRadius="16" Background="{DynamicResource Brush.AccentSoft}">
                                <c:Glyph Data="{DynamicResource Icon.Import}" Width="24" Height="24" Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Migrate.Title}" Style="{StaticResource Text.Title}" />
                                <TextBlock Text="{DynamicResource Migrate.Subtitle}" Style="{StaticResource Text.Muted}" />
                            </StackPanel>
                        </Grid>

                        <!-- Step 0: source + password -->
                        <StackPanel Visibility="{Binding Step, Converter={StaticResource Visible}, ConverterParameter=0}">
                            <TextBlock Text="{DynamicResource Migrate.Source}" Style="{StaticResource Text.Overline}" />
                            <Border Style="{StaticResource Card.Raised}" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <c:Glyph Data="{DynamicResource Icon.Archive}" Width="20" Height="20" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1" Margin="12,0">
                                        <TextBlock Text="{Binding SourcePath}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SourceDetail}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Content="{DynamicResource Common.Browse}" Command="{Binding BrowseCommand}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <TextBlock Text="{DynamicResource Migrate.PasswordLabel}" Style="{StaticResource Text.Overline}" Margin="0,18,0,6" />
                            <c:SecureField Draft="{Binding LegacyPassword}" Placeholder="{DynamicResource Migrate.PasswordPlaceholder}" MinHeight="48" c:Behaviors.FocusOnLoad="True" c:Behaviors.SubmitCommand="{Binding DecryptCommand}" AutomationProperties.AutomationId="LegacyPassword" />
                            <TextBlock Text="{DynamicResource Migrate.Untouched}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,8,0,0" />

                            <Border Background="{DynamicResource Brush.DangerSoft}" CornerRadius="10" Padding="12,9" Margin="0,14,0,0" Visibility="{Binding HasError, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" AutomationProperties.AutomationId="MigrationError" />
                            </Border>
                            <Grid Margin="0,24,0,0">
                                <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource Common.Back}" Command="{Binding BackCommand}" HorizontalAlignment="Left" c:Hint.Icon="{DynamicResource Icon.ChevronLeft}" />
                                <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource Migrate.Decrypt}" c:Hint.Icon="{DynamicResource Icon.Unlock}" Command="{Binding DecryptCommand}" HorizontalAlignment="Right" AutomationProperties.AutomationId="DecryptButton" />
                            </Grid>
                        </StackPanel>

                        <!-- Step 1: new protection -->
                        <StackPanel Visibility="{Binding Step, Converter={StaticResource Visible}, ConverterParameter=1}">
                            <Border Background="{DynamicResource Brush.SuccessSoft}" CornerRadius="10" Padding="12,10">
                                <StackPanel Orientation="Horizontal">
                                    <c:Glyph Data="{DynamicResource Icon.Check}" Width="16" Height="16" Foreground="{DynamicResource Brush.Success}" />
                                    <TextBlock Margin="10,0,0,0" Foreground="{DynamicResource Brush.Success}" TextWrapping="Wrap" MaxWidth="470">
                                        <Run Text="{DynamicResource Migrate.Opened}" /> <Run Text="{Binding LegacyDescription, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{DynamicResource Migrate.NewProtection}" Style="{StaticResource Text.Overline}" Margin="0,20,0,8" />
                            <RadioButton GroupName="pw" IsChecked="{Binding ReusePassword}" Margin="0,0,0,8">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Face" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Brush.Line}" Background="{DynamicResource Brush.SurfaceRaised}" Padding="14,12" Cursor="Hand">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Migrate.Reuse}" FontWeight="SemiBold" />
                                                <TextBlock Text="{DynamicResource Migrate.ReuseDesc}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                            <RadioButton x:Name="NewPasswordOption" GroupName="pw" IsChecked="{Binding ReusePassword, Converter={StaticResource Equals}, ConverterParameter=False}">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Face" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Brush.Line}" Background="{DynamicResource Brush.SurfaceRaised}" Padding="14,12" Cursor="Hand">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Migrate.New}" FontWeight="SemiBold" />
                                                <TextBlock Text="{DynamicResource Migrate.NewDesc}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <StackPanel Margin="0,14,0,0" Visibility="{Binding ReusePassword, Converter={StaticResource Hidden}}">
                                <c:SecureField Draft="{Binding NewPassword}" Placeholder="{DynamicResource Create.PasswordPlaceholder}" MinHeight="46" />
                                <c:StrengthMeter Level="{Binding StrengthLevel}" Margin="2,8,2,10" />
                                <c:SecureField Draft="{Binding Confirm}" Placeholder="{DynamicResource Create.ConfirmPlaceholder}" MinHeight="46" />
                            </StackPanel>

                            <TextBlock Text="{DynamicResource Create.KdfLabel}" Style="{StaticResource Text.Overline}" Margin="0,18,0,6" />
                            <Border Style="{StaticResource Segmented}">
                                <UniformGrid Columns="3">
                                    <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Kdf.Standard}" IsChecked="{Binding Kdf, Converter={StaticResource Equals}, ConverterParameter=Standard}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Kdf.High}" IsChecked="{Binding Kdf, Converter={StaticResource Equals}, ConverterParameter=High}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Kdf.Extreme}" IsChecked="{Binding Kdf, Converter={StaticResource Equals}, ConverterParameter=Extreme}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="{Binding KdfDescription}" Style="{StaticResource Text.Caption}" Margin="2,8,0,0" />

                            <Border Background="{DynamicResource Brush.DangerSoft}" CornerRadius="10" Padding="12,9" Margin="0,14,0,0" Visibility="{Binding HasError, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" />
                            </Border>
                            <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource Migrate.Start}" c:Hint.Icon="{DynamicResource Icon.Seal}" Command="{Binding MigrateCommand}" HorizontalAlignment="Right" Margin="0,24,0,0" AutomationProperties.AutomationId="MigrateButton" />
                        </StackPanel>

                        <!-- Step 2: progress -->
                        <StackPanel Visibility="{Binding Step, Converter={StaticResource Visible}, ConverterParameter=2}" Margin="0,10">
                            <c:SealEmblem Width="140" Height="140" HorizontalAlignment="Center" x:Name="ProgressSeal" />
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                            <UniformGrid Columns="3" Margin="0,16,0,0">
                                <TextBlock Text="{DynamicResource Migrate.Stage1}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Migrate.Stage2}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Migrate.Stage3}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                            </UniformGrid>
                        </StackPanel>

                        <!-- Step 3: report + recovery kit -->
                        <StackPanel Visibility="{Binding Step, Converter={StaticResource Visible}, ConverterParameter=3}">
                            <TextBlock Text="{DynamicResource Migrate.ReportTitle}" Style="{StaticResource Text.Subtitle}" />
                            <UniformGrid Columns="4" Margin="0,14,0,0">
                                <StackPanel Margin="0,0,8,12">
                                    <TextBlock Text="{Binding Report.Entries}" FontSize="26" FontFamily="{StaticResource Font.Display}" Foreground="{DynamicResource Brush.TextAccent}" />
                                    <TextBlock Text="{DynamicResource Migrate.Entries}" Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,12">
                                    <TextBlock Text="{Binding Report.Logins}" FontSize="26" FontFamily="{StaticResource Font.Display}" />
                                    <TextBlock Text="{DynamicResource Migrate.Logins}" Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,12">
                                    <TextBlock Text="{Binding Report.TotpMigrated}" FontSize="26" FontFamily="{StaticResource Font.Display}" />
                                    <TextBlock Text="{DynamicResource Migrate.Totp}" Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,12">
                                    <TextBlock Text="{Binding Report.HistoryItems}" FontSize="26" FontFamily="{StaticResource Font.Display}" />
                                    <TextBlock Text="{DynamicResource Migrate.History}" Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,12">
                                    <TextBlock Text="{Binding Report.Notes}" FontSize="22" FontFamily="{StaticResource Font.Display}" />
                                    <TextBlock Text="{DynamicResource Migrate.Notes}" Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,12">
                                    <TextBlock Text="{Binding Report.Favorites}" FontSize="22" FontFamily="{StaticResource Font.Display}" />
                                    <TextBlock Text="{DynamicResource Migrate.Favorites}" Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,12">
                                    <TextBlock Text="{Binding Report.CustomFields}" FontSize="22" FontFamily="{StaticResource Font.Display}" />
                                    <TextBlock Text="{DynamicResource Migrate.Custom}" Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,12">
                                    <TextBlock Text="{Binding Report.Tags}" FontSize="22" FontFamily="{StaticResource Font.Display}" />
                                    <TextBlock Text="{DynamicResource Migrate.Tags}" Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                            </UniformGrid>

                            <Border Style="{StaticResource Card.Raised}" Margin="0,8,0,0" Padding="18,16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Recovery.Label}" Style="{StaticResource Text.Overline}" />
                                    <c:SecretText Source="{Binding}" Version="{Binding Version}" IsRevealed="True" Colorize="False" Wrap="True" FontSize="16" MaskLength="24" />
                                    <TextBlock Text="{DynamicResource Recovery.Explain}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource Button.Secondary}" Content="{DynamicResource Common.Copy}" c:Hint.Icon="{DynamicResource Icon.Copy}" Command="{Binding CopyCodeCommand}" Margin="0,0,10,0" />
                                <Button Style="{StaticResource Button.Secondary}" Content="{DynamicResource Recovery.SaveFile}" c:Hint.Icon="{DynamicResource Icon.Export}" Command="{Binding SaveCodeCommand}" />
                            </WrapPanel>
                            <CheckBox Content="{DynamicResource Recovery.Acknowledge}" IsChecked="{Binding Acknowledged}" Margin="0,16,0,0" AutomationProperties.AutomationId="MigrationAck" />
                            <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource Migrate.Finish}" c:Hint.Icon="{DynamicResource Icon.Unlock}" Command="{Binding FinishCommand}" HorizontalAlignment="Right" Margin="0,20,0,0" AutomationProperties.AutomationId="MigrationFinish" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
