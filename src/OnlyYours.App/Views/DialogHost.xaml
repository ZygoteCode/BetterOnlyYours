<UserControl x:Class="OnlyYours.App.Views.DialogHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OnlyYours.App.Controls"
             xmlns:vm="clr-namespace:OnlyYours.App.ViewModels"
             AutomationProperties.AutomationId="Dialog">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:ConfirmDialogViewModel}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Style="{StaticResource Button.Ghost}" Content="{Binding CancelText}" Command="{Binding CancelCommand}" Margin="0,0,10,0" Visibility="{Binding ShowCancel, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="DialogCancel" />
                <Button x:Name="Confirm" Style="{StaticResource Button.Primary}" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsDefault="True" c:Behaviors.FocusOnLoad="True" AutomationProperties.AutomationId="DialogConfirm" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDanger}" Value="True">
                    <Setter TargetName="Confirm" Property="Style" Value="{StaticResource Button.Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PasswordDialogViewModel}">
            <StackPanel Margin="0,18,0,0">
                <c:SecureField Draft="{Binding Password}" Placeholder="{DynamicResource Dialog.Password}" MinHeight="46" c:Behaviors.FocusOnLoad="True" c:Behaviors.SubmitCommand="{Binding SubmitCommand}" AutomationProperties.AutomationId="DialogPassword" />
                <StackPanel Visibility="{Binding ShowStrength, Converter={StaticResource Visible}}" Margin="2,8,2,0">
                    <c:StrengthMeter Level="{Binding StrengthLevel}" />
                    <TextBlock Text="{Binding StrengthText}" Foreground="{Binding StrengthLevel, Converter={StaticResource LevelBrush}}" FontSize="{StaticResource Size.Small}" Margin="0,6,0,0" />
                </StackPanel>
                <c:SecureField Draft="{Binding Confirm}" Placeholder="{DynamicResource Dialog.ConfirmPassword}" MinHeight="46" Margin="0,12,0,0" c:Behaviors.SubmitCommand="{Binding SubmitCommand}" Visibility="{Binding HasConfirm, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="DialogConfirmPassword" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource Common.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource Button.Primary}" Content="{Binding ConfirmText}" Command="{Binding SubmitCommand}" AutomationProperties.AutomationId="DialogConfirm" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TextInputDialogViewModel}">
            <StackPanel Margin="0,18,0,0">
                <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Overline}" />
                <TextBox x:Name="Input" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" c:Hint.Placeholder="{Binding Placeholder}" c:Behaviors.FocusOnLoad="True" c:Behaviors.EnterCommand="{Binding SubmitCommand}" AutomationProperties.AutomationId="DialogText" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource Common.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource Button.Primary}" Content="{Binding ConfirmText}" Command="{Binding SubmitCommand}" AutomationProperties.AutomationId="DialogConfirm" />
                </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Multiline}" Value="True">
                    <Setter TargetName="Input" Property="Style" Value="{StaticResource Input.Multiline}" />
                    <Setter TargetName="Input" Property="MinHeight" Value="180" />
                    <Setter TargetName="Input" Property="FontFamily" Value="{StaticResource Font.Mono}" />
                    <Setter TargetName="Input" Property="c:Behaviors.EnterCommand" Value="{x:Null}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RecoveryKeyDialogViewModel}">
            <StackPanel Margin="0,18,0,0">
                <Border Style="{StaticResource Card.Raised}" Padding="18,16">
                    <c:SecretText Source="{Binding}" IsRevealed="{Binding IsRevealed}" Colorize="False" Wrap="True" FontSize="17" MaskLength="24" />
                </Border>
                <WrapPanel Margin="0,12,0,0">
                    <Button Style="{StaticResource Button.Secondary}" Content="{DynamicResource Common.Copy}" c:Hint.Icon="{DynamicResource Icon.Copy}" Command="{Binding CopyCommand}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource Button.Secondary}" Content="{DynamicResource Recovery.SaveFile}" c:Hint.Icon="{DynamicResource Icon.Export}" Command="{Binding SaveCommand}" />
                </WrapPanel>
                <CheckBox Content="{DynamicResource Recovery.Acknowledge}" IsChecked="{Binding Acknowledged}" Margin="0,16,0,0" />
                <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource Common.Done}" Command="{Binding DoneCommand}" HorizontalAlignment="Right" Margin="0,18,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TotpSetupDialogViewModel}">
            <StackPanel Margin="0,18,0,0">
                <c:SecureField Draft="{Binding Input}" Placeholder="otpauth://totp/…  ·  JBSWY3DPEHPK3PXP" MinHeight="46" IsRevealed="True" Colorize="False" c:Behaviors.FocusOnLoad="True" c:Behaviors.SubmitCommand="{Binding SubmitCommand}" AutomationProperties.AutomationId="TotpInput" />
                <Border Style="{StaticResource Card.Raised}" Margin="0,14,0,0" Padding="16,12" Visibility="{Binding IsValid, Converter={StaticResource Visible}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:TotpRing Progress="{Binding Progress}" Seconds="{Binding Seconds}" Width="40" Height="40" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="{Binding Preview}" FontFamily="{StaticResource Font.Mono}" FontSize="24" Foreground="{DynamicResource Brush.TextAccent}" AutomationProperties.AutomationId="TotpPreview" />
                            <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource Common.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource Totp.Save}" Command="{Binding SubmitCommand}" AutomationProperties.AutomationId="DialogConfirm" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SelectionDialogViewModel}">
            <StackPanel Margin="0,14,0,0">
                <Border Background="{DynamicResource Brush.SurfaceRaised}" CornerRadius="10" Padding="12,8" Visibility="{Binding HasNote, Converter={StaticResource Visible}}" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontStyle="Italic" />
                </Border>
                <Button Style="{StaticResource Button.Link}" Content="{DynamicResource Dialog.SelectAll}" Command="{Binding SelectAllCommand}" HorizontalAlignment="Right" Margin="0,0,4,6" />
                <Border Style="{StaticResource Card.Raised}" Padding="4">
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SelectableItem}">
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="10,7">
                                        <StackPanel Orientation="Horizontal">
                                            <c:Glyph Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="15" Height="15" Foreground="{DynamicResource Brush.TextMuted}" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource Common.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource Button.Primary}" Content="{Binding ConfirmText}" Command="{Binding SubmitCommand}" AutomationProperties.AutomationId="DialogConfirm" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ChoiceDialogViewModel}">
            <StackPanel Margin="0,14,0,0">
                <ListBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" Style="{StaticResource List.Plain}" ItemContainerStyle="{StaticResource ListItem.Entry}" MaxHeight="360" AutomationProperties.AutomationId="ChoiceList">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChoiceOption}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}">
                                    <c:Glyph Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="16" Height="16" Foreground="{DynamicResource Brush.Accent}" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxWidth="360" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource Common.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource Button.Primary}" Content="{Binding ConfirmText}" Command="{Binding SubmitCommand}" AutomationProperties.AutomationId="DialogConfirm" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Rectangle x:Name="Scrim" Fill="{DynamicResource Brush.Scrim}" MouseDown="OnScrimClick" />
        <Border x:Name="Card" Width="{Binding Width}" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="20" Background="{DynamicResource Brush.SurfaceRaised}"
                BorderBrush="{DynamicResource Brush.LineStrong}" BorderThickness="1" Padding="28,24" RenderTransformOrigin="0.5,0.5" MaxHeight="{Binding ActualHeight, ElementName=Scrim}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="48" ShadowDepth="14" Opacity="0.55" Color="{DynamicResource Color.Shadow}" />
            </Border.Effect>
            <Border.RenderTransform>
                <ScaleTransform />
            </Border.RenderTransform>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="IconBox" Width="42" Height="42" CornerRadius="13" Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Top">
                            <c:Glyph x:Name="DialogIcon" Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="20" Height="20" Foreground="{DynamicResource Brush.Accent}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" TextTrimming="None" AutomationProperties.AutomationId="DialogTitle" />
                            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" Visibility="{Binding Message, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Width="30" Height="30" c:Hint.Icon="{DynamicResource Icon.Close}" Command="{Binding CancelCommand}" VerticalAlignment="Top" />
                    </Grid>
                    <Border Background="{DynamicResource Brush.DangerSoft}" CornerRadius="10" Padding="12,8" Margin="0,14,0,0" Visibility="{Binding HasError, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" AutomationProperties.AutomationId="DialogError" />
                    </Border>
                    <ContentControl Content="{Binding}" Focusable="False" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
