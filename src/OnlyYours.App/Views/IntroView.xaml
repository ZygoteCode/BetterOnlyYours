<UserControl x:Class="OnlyYours.App.Views.IntroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OnlyYours.App.Controls"
             Focusable="True" Cursor="Arrow"
             AutomationProperties.AutomationId="Intro">
    <Grid x:Name="Root" ClipToBounds="True" Background="Transparent">
        <Rectangle x:Name="Backdrop" Fill="#FF050403" />
        <Rectangle x:Name="Grain" Opacity="0" />
        <Rectangle x:Name="Vignette" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush RadiusX="0.7" RadiusY="0.7">
                    <GradientStop Color="#00000000" Offset="0.4" />
                    <GradientStop Color="#C0000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <c:ParticleField x:Name="Dust" Mode="Vortex" Count="240" Intensity="0" />

        <Grid x:Name="Camera" RenderTransformOrigin="0,0">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CameraScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="CameraTranslate" />
                    <TranslateTransform x:Name="Shake" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Ellipse x:Name="Spark" Width="260" Height="260" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFFFFBF0" Offset="0" />
                        <GradientStop Color="#C0F8D98F" Offset="0.08" />
                        <GradientStop Color="#40E3B261" Offset="0.3" />
                        <GradientStop Color="#00E3B261" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="SparkScale" ScaleX="0" ScaleY="0" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Rectangle x:Name="Flare" Height="6" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#00F8D98F" Offset="0" />
                        <GradientStop Color="#80F8D98F" Offset="0.35" />
                        <GradientStop Color="#FFFFFBF0" Offset="0.5" />
                        <GradientStop Color="#80F8D98F" Offset="0.65" />
                        <GradientStop Color="#00F8D98F" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="FlareScale" ScaleX="0" ScaleY="1" />
                </Rectangle.RenderTransform>
            </Rectangle>

            <c:SealEmblem x:Name="Seal" Width="300" Height="300" IsIdleAnimated="False" RenderTransformOrigin="0.5,0.5" Tag="IntroSeal">
                <c:SealEmblem.RenderTransform>
                    <ScaleTransform x:Name="SealPunch" ScaleX="1" ScaleY="1" />
                </c:SealEmblem.RenderTransform>
            </c:SealEmblem>

            <Canvas x:Name="Wordmark" Width="0" Height="0" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <TextBlock x:Name="Tagline" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
                       FontFamily="{StaticResource Font.Brand}" FontStyle="Italic" FontSize="19" Foreground="#FFCDBFA6"
                       Text="{DynamicResource Brand.Tagline}">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="TaglineShift" Y="14" />
                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>

        <!-- Impact bloom: warm light radiating from the seal, not a flat grey wash. -->
        <Rectangle x:Name="Flash" Opacity="0" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.62" RadiusY="0.9">
                    <GradientStop Color="#F2FFF6DE" Offset="0" />
                    <GradientStop Color="#B8F6D592" Offset="0.16" />
                    <GradientStop Color="#52D9A24A" Offset="0.42" />
                    <GradientStop Color="#00C9902F" Offset="0.82" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="LetterTop" Fill="Black" VerticalAlignment="Top" Height="0" IsHitTestVisible="False" />
        <Rectangle x:Name="LetterBottom" Fill="Black" VerticalAlignment="Bottom" Height="0" IsHitTestVisible="False" />

        <TextBlock x:Name="SkipHint" Text="{DynamicResource Intro.Skip}" Foreground="#FF8A7E6F" FontSize="12" Opacity="0"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" />
    </Grid>
</UserControl>
