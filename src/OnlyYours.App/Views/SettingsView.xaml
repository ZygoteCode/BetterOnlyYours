<UserControl x:Class="OnlyYours.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OnlyYours.App.Controls"
             AutomationProperties.AutomationId="SettingsView">
    <UserControl.Resources>
        <DataTemplate x:Key="ChoiceTemplate">
            <StackPanel Orientation="Horizontal">
                <c:Glyph Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="14" Height="14" Margin="0,0,8,0" Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBlock Text="{Binding Title}" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Pad.Page}" MaxWidth="860">
            <TextBlock Text="{DynamicResource Settings.Title}" Style="{StaticResource Text.Hero}" c:Anim.Enter="Rise" />
            <TextBlock Text="{DynamicResource Settings.Subtitle}" Style="{StaticResource Text.Muted}" Margin="0,6,0,22" c:Anim.Enter="Rise" c:Anim.Delay="60" />

            <!-- Appearance -->
            <TextBlock Text="{DynamicResource Settings.Appearance}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,10" />
            <Border Style="{StaticResource Card}" c:Anim.Enter="Rise" c:Anim.Delay="100">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{DynamicResource Settings.Theme}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Segmented}" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Settings.Theme.Dark}" c:Hint.Icon="{DynamicResource Icon.Moon}" IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=dark}" />
                                <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Settings.Theme.Light}" c:Hint.Icon="{DynamicResource Icon.Sun}" IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=light}" />
                                <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Settings.Theme.System}" c:Hint.Icon="{DynamicResource Icon.Palette}" IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=system}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{DynamicResource Settings.Accent}" VerticalAlignment="Center" />
                        <ListBox ItemsSource="{Binding Accents}" SelectedValuePath="Value" SelectedValue="{Binding Accent}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="AccentList">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="ToolTip" Value="{Binding Title}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid Width="34" Height="34" Margin="6,0,0,0" Background="Transparent">
                                                    <Ellipse x:Name="Ring" Stroke="{DynamicResource Brush.Text}" StrokeThickness="2" Opacity="0" />
                                                    <Ellipse Margin="5" Fill="{Binding Description}" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Ring" Property="Opacity" Value="0.45" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{DynamicResource Settings.Motion}" VerticalAlignment="Center" />
                        <ComboBox Width="240" HorizontalAlignment="Right" ItemsSource="{Binding MotionLevels}" SelectedValuePath="Value" SelectedValue="{Binding MotionLevel}" ItemTemplate="{StaticResource ChoiceTemplate}" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{DynamicResource Settings.Intro}" VerticalAlignment="Center" />
                        <ComboBox Width="240" HorizontalAlignment="Right" ItemsSource="{Binding IntroModes}" SelectedValuePath="Value" SelectedValue="{Binding Intro}" ItemTemplate="{StaticResource ChoiceTemplate}" />
                    </Grid>
                    <CheckBox Style="{StaticResource Toggle}" Content="{DynamicResource Settings.Colorize}" IsChecked="{Binding ColorizePasswords}" Margin="0,10" />
                </StackPanel>
            </Border>

            <!-- Security -->
            <TextBlock Text="{DynamicResource Settings.Security}" Style="{StaticResource Text.Subtitle}" Margin="0,26,0,10" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings.AutoLock}" />
                            <TextBlock Text="{DynamicResource Settings.AutoLockDesc}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                        <ComboBox Width="200" HorizontalAlignment="Right" ItemsSource="{Binding AutoLockOptions}" SelectedValuePath="Value" SelectedValue="{Binding AutoLockMinutes}" ItemTemplate="{StaticResource ChoiceTemplate}" VerticalAlignment="Center" AutomationProperties.AutomationId="AutoLockBox" />
                    </Grid>
                    <CheckBox Style="{StaticResource Toggle}" Content="{DynamicResource Settings.LockOnWindowsLock}" IsChecked="{Binding LockOnWindowsLock}" Margin="0,10" />
                    <CheckBox Style="{StaticResource Toggle}" Content="{DynamicResource Settings.LockOnSleep}" IsChecked="{Binding LockOnSleep}" Margin="0,10" />
                    <CheckBox Style="{StaticResource Toggle}" Content="{DynamicResource Settings.LockOnMinimize}" IsChecked="{Binding LockOnMinimize}" Margin="0,10" />
                    <Rectangle Style="{StaticResource Divider}" Margin="0,8" />
                    <Grid Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings.Clipboard}" />
                            <TextBlock Text="{DynamicResource Settings.ClipboardDesc}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                        <ComboBox Width="200" HorizontalAlignment="Right" ItemsSource="{Binding ClipboardOptions}" SelectedValuePath="Value" SelectedValue="{Binding ClipboardClearSeconds}" ItemTemplate="{StaticResource ChoiceTemplate}" VerticalAlignment="Center" />
                    </Grid>
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ClipboardExcludeHistory}" Margin="0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings.ClipboardHistory}" />
                            <TextBlock Text="{DynamicResource Settings.ClipboardHistoryDesc}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ScreenCaptureProtection}" Margin="0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings.Capture}" />
                            <TextBlock Text="{DynamicResource Settings.CaptureDesc}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ProcessHardening}" Margin="0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings.Hardening}" />
                            <TextBlock Text="{DynamicResource Settings.HardeningDesc}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Toggle}" Content="{DynamicResource Settings.History}" IsChecked="{Binding KeepPasswordHistory}" Margin="0,10" />
                    <CheckBox Style="{StaticResource Toggle}" Content="{DynamicResource Settings.ConfirmDelete}" IsChecked="{Binding ConfirmDelete}" Margin="0,10" />
                    <Grid Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings.Kdf}" />
                            <TextBlock Text="{DynamicResource Settings.KdfDesc}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" />
                        </StackPanel>
                        <ComboBox Width="200" HorizontalAlignment="Right" ItemsSource="{Binding KdfOptions}" SelectedValuePath="Value" SelectedValue="{Binding KdfStrength}" ItemTemplate="{StaticResource ChoiceTemplate}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Behaviour -->
            <TextBlock Text="{DynamicResource Settings.Behavior}" Style="{StaticResource Text.Subtitle}" Margin="0,26,0,10" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding GlobalHotkeys}" Margin="0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings.Hotkeys}" />
                            <TextBlock Text="{Binding HotkeyStatus}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Toggle}" Content="{DynamicResource Settings.MinimizeToTray}" IsChecked="{Binding MinimizeToTray}" Margin="0,10" />
                    <CheckBox Style="{StaticResource Toggle}" Content="{DynamicResource Settings.CloseToTray}" IsChecked="{Binding CloseToTray}" Margin="0,10" />
                    <CheckBox Style="{StaticResource Toggle}" Content="{DynamicResource Settings.StartWithWindows}" IsChecked="{Binding StartWithWindows}" Margin="0,10" />
                    <CheckBox Style="{StaticResource Toggle}" Content="{DynamicResource Settings.StartMinimized}" IsChecked="{Binding StartMinimized}" Margin="0,10" IsEnabled="{Binding StartWithWindows}" />
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{DynamicResource Settings.AutoTypeDelay}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Slider Width="200" Minimum="0" Maximum="150" Value="{Binding AutoTypeDelayMs}" IsSnapToTickEnabled="True" TickFrequency="5" />
                            <TextBlock Text="{Binding AutoTypeDelayMs, StringFormat={}{0} ms}" Width="60" TextAlignment="Right" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{DynamicResource Settings.TrashRetention}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Slider Width="200" Minimum="1" Maximum="90" Value="{Binding TrashRetentionDays}" IsSnapToTickEnabled="True" TickFrequency="1" />
                            <TextBlock Text="{Binding TrashRetentionDays}" Width="60" TextAlignment="Right" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="{DynamicResource Settings.BackupRetention}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Slider Width="200" Minimum="1" Maximum="100" Value="{Binding BackupRetention}" IsSnapToTickEnabled="True" TickFrequency="1" />
                            <TextBlock Text="{Binding BackupRetention}" Width="60" TextAlignment="Right" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Vault -->
            <TextBlock Text="{DynamicResource Settings.Vault}" Style="{StaticResource Text.Subtitle}" Margin="0,26,0,10" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="{Binding VaultName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding VaultFile}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Style="{StaticResource Button.Secondary}" Content="{DynamicResource Settings.Rename}" Command="{Binding RenameVaultCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings.DataFolder}" />
                            <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Style="{StaticResource Button.Secondary}" c:Hint.Icon="{DynamicResource Icon.Folder}" Content="{DynamicResource Settings.Open}" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}" Margin="0,26,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:SealEmblem Width="64" Height="64" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource Font.Brand}" FontSize="20" Foreground="{DynamicResource Brush.TextAccent}"><Run Text="OnlyYours " /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{DynamicResource Brand.Tagline}" Style="{StaticResource Text.Muted}" FontStyle="Italic" />
                        <TextBlock Text="{Binding Runtime}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                        <TextBlock Text="{DynamicResource Settings.AboutText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
