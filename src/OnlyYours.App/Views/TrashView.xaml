<UserControl x:Class="OnlyYours.App.Views.TrashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OnlyYours.App.Controls"
             xmlns:vm="clr-namespace:OnlyYours.App.ViewModels"
             AutomationProperties.AutomationId="TrashView">
    <Grid Margin="{StaticResource Pad.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid c:Anim.Enter="Rise">
            <StackPanel>
                <TextBlock Text="{DynamicResource Trash.Title}" Style="{StaticResource Text.Hero}" />
                <TextBlock Text="{Binding RetentionText}" Style="{StaticResource Text.Muted}" Margin="0,6,0,20" />
            </StackPanel>
            <Button Style="{StaticResource Button.Danger}" c:Hint.Icon="{DynamicResource Icon.Trash}" Content="{DynamicResource Trash.Empty}" Command="{Binding EmptyCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding IsEmpty, Converter={StaticResource Hidden}}" />
        </Grid>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
            <c:Glyph Data="{DynamicResource Icon.Trash}" Width="44" Height="44" Foreground="{DynamicResource Brush.TextFaint}" />
            <TextBlock Text="{DynamicResource Trash.IsEmpty}" Style="{StaticResource Text.Muted}" Margin="0,12,0,0" HorizontalAlignment="Center" />
        </StackPanel>
        <ListBox Grid.Row="1" Style="{StaticResource List.Plain}" ItemContainerStyle="{StaticResource ListItem.Plain}" ItemsSource="{Binding Items}" Visibility="{Binding IsEmpty, Converter={StaticResource Hidden}}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TrashItemViewModel}">
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:Monogram Text="{Binding Title}" Width="38" Height="38" Opacity="0.7" />
                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{Binding Deleted, Mode=OneWay}" /> · <Run Text="{Binding DaysLeft, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{StaticResource Button.Secondary}" c:Hint.Icon="{DynamicResource Icon.Restore}" Content="{DynamicResource Trash.Restore}" Command="{Binding RestoreCommand}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource Button.Icon}" c:Hint.Icon="{DynamicResource Icon.Trash}" c:Hint.Tone="danger" Command="{Binding DeleteCommand}" ToolTip="{DynamicResource Trash.DeleteForever}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
