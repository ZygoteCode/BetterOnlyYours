<UserControl x:Class="OnlyYours.App.Views.LockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OnlyYours.App.Controls"
             AutomationProperties.AutomationId="LockView">
    <Grid>
        <c:ParticleField Mode="Embers" Count="70" Opacity="0.75" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,44,0,0">
            <Grid MinHeight="560">
                <StackPanel Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,70">
                    <c:SealEmblem x:Name="Emblem" Tag="Hero" Width="210" Height="210" HorizontalAlignment="Center" />

                    <TextBlock Text="{Binding VaultName}" Style="{StaticResource Text.Hero}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,20,0,0" AutomationProperties.AutomationId="VaultName" />
                    <TextBlock Text="{DynamicResource Lock.Subtitle}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,26" />

                    <Grid x:Name="InputPanel">
                        <c:SecureField x:Name="PasswordField" Draft="{Binding Password}" Placeholder="{DynamicResource Lock.PasswordPlaceholder}"
                                       MinHeight="52" FontSize="16" c:Behaviors.SubmitCommand="{Binding UnlockCommand}"
                                       Visibility="{Binding UseRecovery, Converter={StaticResource Hidden}}"
                                       AutomationProperties.AutomationId="MasterPassword" AutomationProperties.Name="{DynamicResource Lock.PasswordPlaceholder}" />
                        <c:SecureField x:Name="RecoveryField" Draft="{Binding Recovery}" Placeholder="XXXX-XXXX-XXXX-…" MinHeight="52" FontSize="15"
                                       Colorize="False" IsRevealed="True" c:Behaviors.SubmitCommand="{Binding UnlockCommand}"
                                       Visibility="{Binding UseRecovery, Converter={StaticResource Visible}}"
                                       AutomationProperties.AutomationId="RecoveryKey" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="4,10,0,0" Visibility="{Binding CapsLockOn, ElementName=PasswordField, Converter={StaticResource Visible}}">
                        <c:Glyph Data="{DynamicResource Icon.Warning}" Width="14" Height="14" Foreground="{DynamicResource Brush.Warning}" />
                        <TextBlock Text="{DynamicResource Lock.CapsLock}" Foreground="{DynamicResource Brush.Warning}" Margin="8,0,0,0" FontSize="{StaticResource Size.Small}" />
                    </StackPanel>

                    <Border Background="{DynamicResource Brush.DangerSoft}" CornerRadius="10" Padding="12,9" Margin="0,12,0,0" Visibility="{Binding HasError, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <c:Glyph Data="{DynamicResource Icon.ShieldAlert}" Width="16" Height="16" Foreground="{DynamicResource Brush.Danger}" />
                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="350" AutomationProperties.AutomationId="LockError" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding CooldownText}" Foreground="{DynamicResource Brush.Warning}" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="{Binding IsCoolingDown, Converter={StaticResource Visible}}" />

                    <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource Lock.Unlock}" c:Hint.Icon="{DynamicResource Icon.Unlock}"
                            Command="{Binding UnlockCommand}" MinHeight="50" FontSize="15" Margin="0,18,0,0" HorizontalContentAlignment="Center"
                            AutomationProperties.AutomationId="UnlockButton" />

                    <Button Style="{StaticResource Button.Secondary}" Content="{DynamicResource Lock.Hello}" c:Hint.Icon="{DynamicResource Icon.Fingerprint}"
                            Command="{Binding HelloCommand}" Margin="0,10,0,0" MinHeight="44"
                            Visibility="{Binding HelloAvailable, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="HelloButton" />

                    <WrapPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Style="{StaticResource Button.Link}" Command="{Binding ToggleRecoveryCommand}" Visibility="{Binding HasRecoverySlot, Converter={StaticResource Visible}}" Margin="10,0">
                            <Grid>
                                <TextBlock Text="{DynamicResource Lock.UseRecovery}" Visibility="{Binding UseRecovery, Converter={StaticResource Hidden}}" />
                                <TextBlock Text="{DynamicResource Lock.UsePassword}" Visibility="{Binding UseRecovery, Converter={StaticResource Visible}}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource Button.Link}" Content="{DynamicResource Lock.OpenOther}" Command="{Binding OpenOtherCommand}" Margin="10,0" />
                    </WrapPanel>

                    <TextBlock Text="{Binding FailedText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="{Binding LastUnlockText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
