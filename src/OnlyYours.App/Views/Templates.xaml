<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:OnlyYours.App.Views"
                    xmlns:vm="clr-namespace:OnlyYours.App.ViewModels"
                    xmlns:i="clr-namespace:OnlyYours.App.Infrastructure">

    <!-- Shared converters -->
    <i:VisibleWhen x:Key="Visible" />
    <i:VisibleWhen x:Key="Hidden" Invert="True" />
    <i:EqualsParameter x:Key="Equals" />
    <i:IconConverter x:Key="Icon" />
    <i:ToneBrush x:Key="Tone" />
    <i:ToneBrush x:Key="ToneSoft" Soft="True" />
    <i:LevelBrush x:Key="LevelBrush" />
    <i:LocConverter x:Key="Loc" />
    <BooleanToVisibilityConverter x:Key="BoolVisible" />

    <!-- Stages -->
    <DataTemplate DataType="{x:Type vm:WelcomeViewModel}">
        <v:WelcomeView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LockViewModel}">
        <v:LockView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CreateVaultViewModel}">
        <v:CreateVaultView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MigrationViewModel}">
        <v:MigrationView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ShellViewModel}">
        <v:ShellView />
    </DataTemplate>

    <!-- Shell content -->
    <DataTemplate DataType="{x:Type vm:EntryDetailViewModel}">
        <v:EntryDetailView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:EntryEditorViewModel}">
        <v:EntryEditorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:GeneratorViewModel}">
        <v:GeneratorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SecurityViewModel}">
        <v:SecurityView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SharingViewModel}">
        <v:SharingView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TrashViewModel}">
        <v:TrashView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TransferViewModel}">
        <v:TransferView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <v:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PaletteViewModel}">
        <v:PaletteView />
    </DataTemplate>

</ResourceDictionary>
