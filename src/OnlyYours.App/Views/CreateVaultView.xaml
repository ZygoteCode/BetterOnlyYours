<UserControl x:Class="OnlyYours.App.Views.CreateVaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OnlyYours.App.Controls"
             AutomationProperties.AutomationId="CreateVaultView">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,44,0,0">
            <Grid MinHeight="620">
                <Border Style="{StaticResource Card}" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36,32" Margin="0,10,0,30" c:Anim.Enter="Rise">
                    <StackPanel>
                        <!-- Stepper -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:SealEmblem Width="54" Height="54" IsIdleAnimated="True" />
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Create.Title}" Style="{StaticResource Text.Title}" />
                                <TextBlock Text="{Binding StepTitle}" Style="{StaticResource Text.Muted}" />
                            </StackPanel>
                        </Grid>
                        <UniformGrid Columns="4" Margin="0,0,0,26">
                            <Border Height="3" CornerRadius="2" Margin="0,0,6,0" Background="{DynamicResource Brush.AccentGradient}" />
                            <Border Height="3" CornerRadius="2" Margin="3,0" Background="{DynamicResource Brush.Line}" x:Name="Step1Bar" />
                            <Border Height="3" CornerRadius="2" Margin="3,0" Background="{DynamicResource Brush.Line}" x:Name="Step2Bar" />
                            <Border Height="3" CornerRadius="2" Margin="6,0,0,0" Background="{DynamicResource Brush.Line}" x:Name="Step3Bar" />
                        </UniformGrid>

                        <!-- Step 0: credentials -->
                        <StackPanel Visibility="{Binding Step, Converter={StaticResource Visible}, ConverterParameter=0}">
                            <TextBlock Text="{DynamicResource Create.NameLabel}" Style="{StaticResource Text.Overline}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" c:Hint.Icon="{DynamicResource Icon.Seal}" AutomationProperties.AutomationId="VaultNameInput" />

                            <TextBlock Text="{DynamicResource Create.PasswordLabel}" Style="{StaticResource Text.Overline}" Margin="0,18,0,6" />
                            <c:SecureField x:Name="PasswordField" Draft="{Binding Password}" Placeholder="{DynamicResource Create.PasswordPlaceholder}" MinHeight="48" c:Behaviors.FocusOnLoad="True" AutomationProperties.AutomationId="NewPassword" />
                            <c:StrengthMeter Level="{Binding StrengthLevel}" Margin="2,10,2,0" />
                            <Grid Margin="2,8,2,0">
                                <TextBlock Text="{Binding StrengthText}" Foreground="{Binding StrengthLevel, Converter={StaticResource LevelBrush}}" FontWeight="SemiBold" FontSize="{StaticResource Size.Small}" />
                                <TextBlock Text="{Binding CrackText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Text="{Binding StrengthAdvice}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,4,2,0" />

                            <TextBlock Text="{DynamicResource Create.ConfirmLabel}" Style="{StaticResource Text.Overline}" Margin="0,16,0,6" />
                            <c:SecureField Draft="{Binding Confirm}" Placeholder="{DynamicResource Create.ConfirmPlaceholder}" MinHeight="48" c:Behaviors.SubmitCommand="{Binding CreateCommand}" AutomationProperties.AutomationId="ConfirmPassword" />
                            <TextBlock Text="{Binding ConfirmState}" Margin="2,6,0,0" FontSize="{StaticResource Size.Small}" Foreground="{DynamicResource Brush.TextMuted}" />

                            <TextBlock Text="{DynamicResource Create.KdfLabel}" Style="{StaticResource Text.Overline}" Margin="0,18,0,6" />
                            <Border Style="{StaticResource Segmented}">
                                <UniformGrid Columns="3">
                                    <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Kdf.Standard}" IsChecked="{Binding Kdf, Converter={StaticResource Equals}, ConverterParameter=Standard}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Kdf.High}" IsChecked="{Binding Kdf, Converter={StaticResource Equals}, ConverterParameter=High}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Kdf.Extreme}" IsChecked="{Binding Kdf, Converter={StaticResource Equals}, ConverterParameter=Extreme}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="{Binding KdfDescription}" Style="{StaticResource Text.Caption}" Margin="2,8,0,0" />

                            <Border Background="{DynamicResource Brush.DangerSoft}" CornerRadius="10" Padding="12,9" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" />
                            </Border>

                            <Grid Margin="0,24,0,0">
                                <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource Common.Back}" Command="{Binding BackCommand}" HorizontalAlignment="Left" c:Hint.Icon="{DynamicResource Icon.ChevronLeft}" />
                                <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource Create.Seal}" Command="{Binding CreateCommand}" HorizontalAlignment="Right" c:Hint.Icon="{DynamicResource Icon.Lock}" AutomationProperties.AutomationId="CreateVaultButton" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}">
                                <TextBlock Text="{DynamicResource Create.Deriving}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Step 1: recovery kit -->
                        <StackPanel Visibility="{Binding Step, Converter={StaticResource Visible}, ConverterParameter=1}">
                            <TextBlock Text="{DynamicResource Recovery.Explain}" Style="{StaticResource Text.Muted}" />
                            <Border Style="{StaticResource Card.Raised}" Margin="0,18,0,0" Padding="18,16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Recovery.Label}" Style="{StaticResource Text.Overline}" />
                                    <c:SecretText Source="{Binding}" Version="{Binding Version}" IsRevealed="{Binding CodeRevealed}" Colorize="False" Wrap="True" FontSize="17" MaskLength="24" Margin="0,4,0,0" AutomationProperties.AutomationId="RecoveryCode" />
                                </StackPanel>
                            </Border>
                            <WrapPanel Margin="0,14,0,0">
                                <Button Style="{StaticResource Button.Secondary}" Content="{DynamicResource Common.Copy}" c:Hint.Icon="{DynamicResource Icon.Copy}" Command="{Binding CopyCodeCommand}" Margin="0,0,10,0" />
                                <Button Style="{StaticResource Button.Secondary}" Content="{DynamicResource Recovery.SaveFile}" c:Hint.Icon="{DynamicResource Icon.Export}" Command="{Binding SaveCodeCommand}" />
                            </WrapPanel>
                            <Border Background="{DynamicResource Brush.WarningSoft}" CornerRadius="10" Padding="12,10" Margin="0,18,0,0">
                                <TextBlock Text="{DynamicResource Recovery.Warning}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" />
                            </Border>
                            <CheckBox Content="{DynamicResource Recovery.Acknowledge}" IsChecked="{Binding Acknowledged}" Margin="0,18,0,0" AutomationProperties.AutomationId="RecoveryAck" />
                            <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource Common.Continue}" Command="{Binding ContinueCommand}" HorizontalAlignment="Right" Margin="0,20,0,0" AutomationProperties.AutomationId="RecoveryContinue" />
                        </StackPanel>

                        <!-- Step 2: Windows Hello -->
                        <StackPanel Visibility="{Binding Step, Converter={StaticResource Visible}, ConverterParameter=2}">
                            <Border Width="72" Height="72" CornerRadius="22" Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Left">
                                <c:Glyph Data="{DynamicResource Icon.Fingerprint}" Width="34" Height="34" Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <TextBlock Text="{DynamicResource Hello.Title}" Style="{StaticResource Text.Subtitle}" Margin="0,18,0,0" />
                            <TextBlock Text="{DynamicResource Hello.Explain}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" />
                            <Border Background="{DynamicResource Brush.DangerSoft}" CornerRadius="10" Padding="12,9" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" />
                            </Border>
                            <Grid Margin="0,26,0,0">
                                <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource Hello.Skip}" Command="{Binding ContinueCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="HelloSkip" />
                                <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource Hello.Enable}" c:Hint.Icon="{DynamicResource Icon.Fingerprint}" Command="{Binding EnableHelloCommand}" AutomationProperties.AutomationId="HelloEnable" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <!-- Step 3: done -->
                        <StackPanel Visibility="{Binding Step, Converter={StaticResource Visible}, ConverterParameter=3}">
                            <c:SealEmblem x:Name="DoneSeal" Width="150" Height="150" HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Create.DoneTitle}" Style="{StaticResource Text.Hero}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,16,0,0" />
                            <TextBlock Text="{DynamicResource Create.DoneMessage}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0" />
                            <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource Create.Open}" c:Hint.Icon="{DynamicResource Icon.Unlock}" Command="{Binding FinishCommand}" HorizontalAlignment="Center" Margin="0,26,0,0" MinHeight="46" AutomationProperties.AutomationId="OpenVaultButton" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
