<UserControl x:Class="OnlyYours.App.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OnlyYours.App.Controls"
             xmlns:vm="clr-namespace:OnlyYours.App.ViewModels"
             AutomationProperties.AutomationId="ShellView">
    <UserControl.Resources>
        <DataTemplate x:Key="RailItemTemplate" DataType="{x:Type vm:RailItemViewModel}">
            <Button Style="{StaticResource Rail.Item}" c:Hint.IsActive="{Binding IsSelected}" Margin="0,1"
                    Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                    ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}" AutomationProperties.AutomationId="{Binding Key}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:Glyph Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="17" Height="17" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="12,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" x:Name="Label" />
                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="11.5" Foreground="{DynamicResource Brush.TextFaint}" VerticalAlignment="Center" Visibility="{Binding HasCount, Converter={StaticResource Visible}}" x:Name="Counter" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DataContext.RailCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Counter" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="EntryTemplate" DataType="{x:Type vm:EntryItemViewModel}">
            <Grid x:Name="Row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:Monogram Text="{Binding Title}" IsFavorite="{Binding IsFavorite}" Width="38" Height="38" />
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock c:HighlightText.Text="{Binding Title}" c:HighlightText.Positions="{Binding Matches}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="6" Padding="6,2" Margin="0,0,6,0" Background="{Binding Badge, Converter={StaticResource ToneSoft}}" Visibility="{Binding HasBadge, Converter={StaticResource Visible}}" ToolTip="{Binding BadgeText}">
                        <c:Glyph Data="{DynamicResource Icon.Warning}" Width="12" Height="12" Foreground="{Binding Badge, Converter={StaticResource Tone}}" />
                    </Border>
                    <c:Glyph Data="{DynamicResource Icon.Timer}" Width="14" Height="14" Foreground="{DynamicResource Brush.TextFaint}" Margin="0,0,6,0" Visibility="{Binding HasTotp, Converter={StaticResource Visible}}" ToolTip="2FA" />
                    <c:Glyph Data="{DynamicResource Icon.Star}" Width="14" Height="14" Foreground="{DynamicResource Brush.Accent}" Fill="{DynamicResource Brush.Accent}" Visibility="{Binding IsFavorite, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,44,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="236" />
            <ColumnDefinition x:Name="ListColumn" Width="350" MinWidth="260" MaxWidth="560" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- ========================================================= rail -->
        <Border Grid.RowSpan="1" Background="{DynamicResource Brush.Rail}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,1,0" c:Anim.Enter="Left">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="10,10,10,6">
                    <Button x:Name="NewButton" Style="{StaticResource Button.Primary}" c:Hint.Icon="{DynamicResource Icon.Plus}" Content="{DynamicResource Shell.New}" Click="OnNewClick" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="NewEntryButton">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="NewMenu" />
                        </Button.ContextMenu>
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,4">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Rail}" ItemTemplate="{StaticResource RailItemTemplate}" Focusable="False" />
                        <TextBlock Text="{DynamicResource Shell.Tags}" Style="{StaticResource Text.Overline}" Margin="12,16,0,4" Visibility="{Binding RailTags.Count, Converter={StaticResource Visible}}" x:Name="TagsHeader" />
                        <ItemsControl ItemsSource="{Binding RailTags}" ItemTemplate="{StaticResource RailItemTemplate}" Focusable="False" />
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="8,6,8,10">
                    <Rectangle Style="{StaticResource Divider}" Margin="6,0,6,8" />
                    <ItemsControl ItemsSource="{Binding RailPages}" ItemTemplate="{StaticResource RailItemTemplate}" Focusable="False" />
                    <Button Style="{StaticResource Button.Ghost}" c:Hint.Icon="{DynamicResource Icon.Sidebar}" HorizontalAlignment="Left" Command="{Binding ToggleRailCommand}" Margin="2,4,0,0" ToolTip="{DynamicResource Shell.ToggleRail}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= list -->
        <Grid Grid.Column="1" x:Name="ListPane" Visibility="{Binding IsVaultPage, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="18,14,14,4">
                <StackPanel>
                    <TextBlock Text="{Binding ListTitle}" Style="{StaticResource Text.Subtitle}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                        <Run Text="{Binding Items.Count, Mode=OneWay}" /> <Run Text="{DynamicResource Shell.Items}" />
                    </TextBlock>
                </StackPanel>
                <ComboBox HorizontalAlignment="Right" VerticalAlignment="Center" Width="150" ItemsSource="{Binding SortOptions}" SelectedValuePath="Value" SelectedValue="{Binding Sort}" ToolTip="{DynamicResource Shell.Sort}" AutomationProperties.AutomationId="SortBox">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <c:Glyph Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="14" Height="14" Margin="0,0,8,0" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <TextBox Grid.Row="1" x:Name="SearchBox" Margin="14,8,14,8" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=40}"
                     c:Hint.Icon="{DynamicResource Icon.Search}" c:Hint.Placeholder="{DynamicResource Shell.SearchPlaceholder}"
                     PreviewKeyDown="OnSearchKey" AutomationProperties.AutomationId="SearchBox" />
            <ListBox Grid.Row="2" x:Name="EntryList" Style="{StaticResource List.Plain}" ItemContainerStyle="{StaticResource ListItem.Entry}"
                     ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" ItemTemplate="{StaticResource EntryTemplate}"
                     Padding="0,2,0,12" AutomationProperties.AutomationId="EntryList" MouseDoubleClick="OnEntryDoubleClick" />

            <!-- empty states -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Visibility="{Binding IsEmptyVault, Converter={StaticResource Visible}}">
                <c:Glyph Data="{DynamicResource Icon.Seal}" Width="40" Height="40" Foreground="{DynamicResource Brush.Accent}" />
                <TextBlock Text="{DynamicResource Shell.EmptyVault}" Style="{StaticResource Text.Subtitle}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock Text="{DynamicResource Shell.EmptyVaultHint}" Style="{StaticResource Text.Muted}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="250" Margin="0,6,0,0" />
                <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource Shell.CreateFirst}" c:Hint.Icon="{DynamicResource Icon.Plus}" Command="{Binding NewEntryCommand}" HorizontalAlignment="Center" Margin="0,18,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Visibility="{Binding ShowNoMatches, Converter={StaticResource Visible}}">
                <c:Glyph Data="{DynamicResource Icon.Search}" Width="34" Height="34" Foreground="{DynamicResource Brush.TextFaint}" />
                <TextBlock Text="{DynamicResource Shell.EmptyList}" Style="{StaticResource Text.Muted}" TextAlignment="Center" Margin="0,12,0,0" />
                <Button Style="{StaticResource Button.Link}" Content="{DynamicResource Shell.ClearFilters}" Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>

        <GridSplitter Grid.Column="2" Width="5" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Visibility="{Binding IsVaultPage, Converter={StaticResource Visible}}" DragCompleted="OnSplitterDragged">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent" Cursor="SizeWE">
                        <Rectangle Width="1" Fill="{DynamicResource Brush.Line}" HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- ======================================================= detail -->
        <Grid Grid.Column="3" Visibility="{Binding IsVaultPage, Converter={StaticResource Visible}}">
            <ContentControl Content="{Binding Detail}" Visibility="{Binding IsEditing, Converter={StaticResource Hidden}}" Focusable="False" x:Name="DetailHost" />
            <ContentControl Content="{Binding Editor}" Visibility="{Binding IsEditing, Converter={StaticResource Visible}}" Focusable="False" />

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ShowEmptyState, Converter={StaticResource Visible}}" Margin="30">
                <c:SealEmblem Width="150" Height="150" Opacity="0.85" />
                <TextBlock Text="{DynamicResource Shell.EmptyTitle}" Style="{StaticResource Text.Hero}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,18,0,0" />
                <TextBlock Text="{DynamicResource Shell.EmptyHint}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420" Margin="0,8,0,20" />
                <WrapPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="10,4">
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="Ctrl+N" FontSize="11" /></Border>
                        <TextBlock Text="{DynamicResource Shell.HintNew}" Style="{StaticResource Text.Caption}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,4">
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="Ctrl+K" FontSize="11" /></Border>
                        <TextBlock Text="{DynamicResource Shell.HintPalette}" Style="{StaticResource Text.Caption}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,4">
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="Ctrl+Alt+P" FontSize="11" /></Border>
                        <TextBlock Text="{DynamicResource Shell.HintGlobal}" Style="{StaticResource Text.Caption}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Grid>

        <!-- ======================================================== pages -->
        <c:TransitionHost Grid.Column="1" Grid.ColumnSpan="3" Content="{Binding PageViewModel}" Transition="Slide" Visibility="{Binding IsVaultPage, Converter={StaticResource Hidden}}" />

        <!-- =================================================== status bar -->
        <Border Grid.Row="1" Grid.ColumnSpan="4" Background="{DynamicResource Brush.Rail}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Success}" x:Name="SaveDot" />
                    <TextBlock Text="{Binding SaveText}" Style="{StaticResource Text.Caption}" Margin="7,0,0,0" AutomationProperties.AutomationId="SaveStatus" />
                    <Button Style="{StaticResource Button.Link}" Content="{DynamicResource Save.Retry}" Command="{Binding RetrySaveCommand}" FontSize="11.5" Margin="8,0,0,0" Visibility="{Binding SaveFailed, Converter={StaticResource Visible}}" />
                    <TextBlock Text="·" Style="{StaticResource Text.Caption}" Margin="10,0" />
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.Caption}" />
                    <TextBlock Text="·" Style="{StaticResource Text.Caption}" Margin="10,0" />
                    <c:Glyph Data="{DynamicResource Icon.Chip}" Width="12" Height="12" Foreground="{DynamicResource Brush.TextFaint}" />
                    <TextBlock Text="{Binding MemoryText}" Style="{StaticResource Text.Caption}" Margin="6,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasClipboard, Converter={StaticResource Visible}}" Margin="0,0,14,0">
                        <c:Glyph Data="{DynamicResource Icon.Clipboard}" Width="12" Height="12" Foreground="{DynamicResource Brush.TextAccent}" />
                        <TextBlock Text="{Binding ClipboardText}" Foreground="{DynamicResource Brush.TextAccent}" FontSize="{StaticResource Size.Caption}" Margin="6,0,0,0" AutomationProperties.AutomationId="ClipboardStatus" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasAutoLock, Converter={StaticResource Visible}}" Margin="0,0,14,0">
                        <c:Glyph Data="{DynamicResource Icon.Hourglass}" Width="12" Height="12" Foreground="{DynamicResource Brush.TextFaint}" />
                        <TextBlock Text="{Binding AutoLockText}" Style="{StaticResource Text.Caption}" Margin="6,0,0,0" />
                    </StackPanel>
                    <c:Glyph Data="{DynamicResource Icon.ShieldCheck}" Width="12" Height="12" Foreground="{DynamicResource Brush.Success}" />
                    <TextBlock Text="{Binding CryptoText}" Style="{StaticResource Text.Caption}" Margin="6,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
