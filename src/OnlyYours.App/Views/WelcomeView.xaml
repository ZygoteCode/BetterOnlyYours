<UserControl x:Class="OnlyYours.App.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OnlyYours.App.Controls"
             AutomationProperties.AutomationId="WelcomeView">
    <Grid>
        <c:ParticleField Mode="Embers" Count="60" Opacity="0.6" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,44,0,0">
            <Grid MinHeight="600">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="760" Margin="0,0,0,40">
                    <c:SealEmblem Tag="Hero" HorizontalAlignment="Center">
                        <c:SealEmblem.Style>
                            <Style TargetType="c:SealEmblem">
                                <Setter Property="Width" Value="170" />
                                <Setter Property="Height" Value="170" />
                                <Style.Triggers>
                                    <!-- Room for the migration card: a smaller seal keeps everything above the fold. -->
                                    <DataTrigger Binding="{Binding HasLegacy}" Value="True">
                                        <Setter Property="Width" Value="126" />
                                        <Setter Property="Height" Value="126" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </c:SealEmblem.Style>
                    </c:SealEmblem>
                    <TextBlock Text="{DynamicResource Welcome.Title}" Style="{StaticResource Text.Display}" HorizontalAlignment="Center" Margin="0,22,0,0" c:Anim.Enter="Rise" c:Anim.Delay="80" />
                    <TextBlock Text="{DynamicResource Brand.Tagline}" FontFamily="{StaticResource Font.Brand}" FontStyle="Italic" FontSize="19" Foreground="{DynamicResource Brush.TextAccent}" HorizontalAlignment="Center" Margin="0,6,0,0" c:Anim.Enter="Rise" c:Anim.Delay="160" />
                    <TextBlock Text="{DynamicResource Welcome.Subtitle}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="560" Margin="0,14,0,34" c:Anim.Enter="Rise" c:Anim.Delay="220" />

                    <!-- Migration highlight -->
                    <Button Style="{StaticResource Button.Card}" Command="{Binding MigrateCommand}" Margin="0,0,0,14" Visibility="{Binding HasLegacy, Converter={StaticResource Visible}}"
                            c:Anim.Enter="Rise" c:Anim.Delay="280" AutomationProperties.AutomationId="MigrateCard">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Top">
                                <c:Glyph Data="{DynamicResource Icon.Import}" Width="22" Height="22" Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="18,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Welcome.Migrate}" Style="{StaticResource Text.Subtitle}" />
                                    <Border Style="{StaticResource Chip}" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Welcome.Found}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextAccent}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Welcome.MigrateDesc}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding LegacyDetail}" ToolTip="{Binding LegacyPath}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding LegacyHeader}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <c:Glyph Grid.Column="2" Data="{DynamicResource Icon.ChevronRight}" Width="18" Height="18" Foreground="{DynamicResource Brush.TextFaint}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <UniformGrid Columns="2" c:Anim.Enter="Rise" c:Anim.Delay="340">
                        <Button Style="{StaticResource Button.Card}" Command="{Binding CreateCommand}" Margin="0,0,7,0" AutomationProperties.AutomationId="CreateCard">
                            <StackPanel>
                                <Border Width="44" Height="44" CornerRadius="13" Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Left">
                                    <c:Glyph Data="{DynamicResource Icon.Sparkle}" Width="20" Height="20" Foreground="{DynamicResource Brush.Accent}" />
                                </Border>
                                <TextBlock Text="{DynamicResource Welcome.Create}" Style="{StaticResource Text.Subtitle}" Margin="0,14,0,0" />
                                <TextBlock Text="{DynamicResource Welcome.CreateDesc}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Card}" Command="{Binding OpenCommand}" Margin="7,0,0,0" AutomationProperties.AutomationId="OpenCard">
                            <StackPanel>
                                <Border Width="44" Height="44" CornerRadius="13" Background="{DynamicResource Brush.SurfaceHover}" HorizontalAlignment="Left">
                                    <c:Glyph Data="{DynamicResource Icon.Folder}" Width="20" Height="20" Foreground="{DynamicResource Brush.TextMuted}" />
                                </Border>
                                <TextBlock Text="{DynamicResource Welcome.Open}" Style="{StaticResource Text.Subtitle}" Margin="0,14,0,0" />
                                <TextBlock Text="{DynamicResource Welcome.OpenDesc}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0" c:Anim.Enter="Fade" c:Anim.Delay="520">
                        <c:Glyph Data="{DynamicResource Icon.ShieldCheck}" Width="15" Height="15" Foreground="{DynamicResource Brush.Success}" />
                        <TextBlock Text="{DynamicResource Welcome.Privacy}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
