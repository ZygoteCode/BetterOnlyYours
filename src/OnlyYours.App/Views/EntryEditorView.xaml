<UserControl x:Class="OnlyYours.App.Views.EntryEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OnlyYours.App.Controls"
             xmlns:vm="clr-namespace:OnlyYours.App.ViewModels"
             AutomationProperties.AutomationId="EntryEditor">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24,32,24" MaxWidth="820">
                <Grid c:Anim.Enter="Rise">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="16" Background="{DynamicResource Brush.AccentSoft}">
                        <c:Glyph Data="{Binding KindIcon, Converter={StaticResource Icon}}" Width="24" Height="24" Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.Overline}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Large}" c:Hint.Placeholder="{DynamicResource Editor.TitlePlaceholder}" c:Behaviors.FocusOnLoad="True" AutomationProperties.AutomationId="EditorTitle" />
                    </StackPanel>
                    <ToggleButton Grid.Column="2" Style="{StaticResource Button.Icon}" c:Hint.Icon="{DynamicResource Icon.Star}" IsChecked="{Binding Favorite}" c:Hint.IsActive="{Binding Favorite}" VerticalAlignment="Bottom" Margin="0,0,0,4" ToolTip="{DynamicResource Detail.Favorite}" />
                </Grid>

                <!-- Fields -->
                <ItemsControl ItemsSource="{Binding Fields}" Margin="0,22,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EditableFieldViewModel}">
                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10" c:Anim.Enter="Rise">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <c:Glyph Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="14" Height="14" Foreground="{DynamicResource Brush.TextFaint}" />
                                            <TextBlock Text="{Binding DisplayLabel}" Style="{StaticResource Text.Overline}" Margin="8,0,0,6" Visibility="{Binding IsCustom, Converter={StaticResource Hidden}}" />
                                            <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" MinHeight="26" Padding="6,0" FontSize="12" Margin="8,0,0,6" MinWidth="180" Visibility="{Binding IsCustom, Converter={StaticResource Visible}}" c:Hint.Placeholder="{DynamicResource Editor.LabelPlaceholder}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Opacity="0.7">
                                            <Button Style="{StaticResource Button.Icon}" Width="26" Height="26" c:Hint.Icon="{DynamicResource Icon.ChevronUp}" Command="{Binding MoveUpCommand}" ToolTip="{DynamicResource Editor.MoveUp}" />
                                            <Button Style="{StaticResource Button.Icon}" Width="26" Height="26" c:Hint.Icon="{DynamicResource Icon.ChevronDown}" Command="{Binding MoveDownCommand}" ToolTip="{DynamicResource Editor.MoveDown}" />
                                            <Button Style="{StaticResource Button.Icon}" Width="26" Height="26" c:Hint.Icon="{DynamicResource Icon.Close}" c:Hint.Tone="danger" Command="{Binding RemoveCommand}" ToolTip="{DynamicResource Editor.RemoveField}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsPlainSingleLine, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding DisplayLabel}" />
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Multiline}" Visibility="{Binding IsPlainMultiline, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding DisplayLabel}" />
                                        <c:SecureField Draft="{Binding Secret}" IsRevealed="{Binding IsRevealed, Mode=TwoWay}" Visibility="{Binding IsSecretSingleLine, Converter={StaticResource Visible}}" Placeholder="{Binding DisplayLabel}" AutomationProperties.Name="{Binding DisplayLabel}">
                                            <c:SecureField.Trailing>
                                                <Button Style="{StaticResource Button.Icon}" Width="32" Height="32" c:Hint.Icon="{DynamicResource Icon.Dice}" Command="{Binding GenerateCommand}" ToolTip="{DynamicResource Editor.Generate}" Visibility="{Binding CanGenerate, Converter={StaticResource Visible}}" Focusable="False" AutomationProperties.AutomationId="GenerateButton" />
                                            </c:SecureField.Trailing>
                                        </c:SecureField>
                                        <TextBox c:SecretTextBox.Draft="{Binding Secret}" Visibility="{Binding IsSecretMultiline, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding DisplayLabel}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource Input.Multiline}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMonospace}" Value="True">
                                                            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>

                                    <Grid Grid.Row="2" Margin="2,8,2,0" Visibility="{Binding ShowStrength, Converter={StaticResource Visible}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <c:StrengthMeter Level="{Binding StrengthLevel}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding StrengthText}" Foreground="{Binding StrengthLevel, Converter={StaticResource LevelBrush}}" FontSize="{StaticResource Size.Small}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button x:Name="AddFieldButton" Style="{StaticResource Button.Ghost}" c:Hint.Icon="{DynamicResource Icon.Plus}" Content="{DynamicResource Editor.AddField}" HorizontalAlignment="Left" Click="OnAddField" />

                <!-- Two-factor -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,12" Visibility="{Binding CanHaveTotp, Converter={StaticResource Visible}}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <c:Glyph Data="{DynamicResource Icon.Timer}" Width="18" Height="18" Foreground="{DynamicResource Brush.Accent}" />
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="{DynamicResource Editor.Totp}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TotpStatus}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource Common.Remove}" Command="{Binding RemoveTotpCommand}" Visibility="{Binding HasTotp, Converter={StaticResource Visible}}" />
                            <Button Style="{StaticResource Button.Secondary}" Content="{DynamicResource Editor.SetupTotp}" Command="{Binding SetupTotpCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="SetupTotpButton" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tags, expiry, auto-type -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Editor.Tags}" Style="{StaticResource Text.Overline}" />
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding Tags}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}" Padding="9,2,3,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource Brush.TextAccent}" VerticalAlignment="Center" />
                                                <Button Style="{StaticResource Button.Icon}" Width="20" Height="20" c:Hint.Icon="{DynamicResource Icon.Close}" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}" MinWidth="200" MinHeight="32" c:Hint.Placeholder="{DynamicResource Editor.TagPlaceholder}" c:Behaviors.EnterCommand="{Binding AddTagCommand}" />
                        </WrapPanel>

                        <TextBlock Text="{DynamicResource Editor.Expiry}" Style="{StaticResource Text.Overline}" Margin="0,16,0,6" />
                        <WrapPanel>
                            <TextBox Text="{Binding ExpiresText, UpdateSourceTrigger=PropertyChanged}" Width="160" c:Hint.Icon="{DynamicResource Icon.Calendar}" c:Hint.Placeholder="{DynamicResource Editor.ExpiryPlaceholder}" Margin="0,0,10,0" />
                            <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource Editor.Expiry30}" Command="{Binding SetExpiryCommand}" CommandParameter="30" />
                            <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource Editor.Expiry90}" Command="{Binding SetExpiryCommand}" CommandParameter="90" />
                            <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource Editor.Expiry365}" Command="{Binding SetExpiryCommand}" CommandParameter="365" />
                            <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource Editor.ExpiryNone}" Command="{Binding SetExpiryCommand}" CommandParameter="0" />
                        </WrapPanel>

                        <StackPanel Visibility="{Binding CanAutoType, Converter={StaticResource Visible}}">
                            <TextBlock Text="{DynamicResource Editor.AutoType}" Style="{StaticResource Text.Overline}" Margin="0,16,0,6" />
                            <TextBox Text="{Binding AutoType, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" c:Hint.Placeholder="{}{USERNAME}{TAB}{PASSWORD}{ENTER}" c:Hint.Icon="{DynamicResource Icon.Keyboard}" />
                            <TextBlock Text="{DynamicResource Editor.AutoTypeHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Rail}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="32,12">
            <Grid>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center" Visibility="{Binding HasError, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="EditorError" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Ghost}" Content="{DynamicResource Common.Cancel}" Command="{Binding CancelCommand}" ToolTip="Esc" Margin="0,0,10,0" AutomationProperties.AutomationId="EditorCancel" />
                    <Button Style="{StaticResource Button.Primary}" c:Hint.Icon="{DynamicResource Icon.Check}" Content="{DynamicResource Common.Save}" Command="{Binding SaveCommand}" ToolTip="Ctrl+S" AutomationProperties.AutomationId="EditorSave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
