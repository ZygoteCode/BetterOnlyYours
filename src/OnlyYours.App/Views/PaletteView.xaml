<UserControl x:Class="OnlyYours.App.Views.PaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OnlyYours.App.Controls"
             xmlns:vm="clr-namespace:OnlyYours.App.ViewModels"
             Width="660" AutomationProperties.AutomationId="Palette">
    <Border x:Name="Card" CornerRadius="18" Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.LineStrong}" BorderThickness="1" RenderTransformOrigin="0.5,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="12" Opacity="0.55" Color="{DynamicResource Color.Shadow}" />
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform />
        </Border.RenderTransform>
        <StackPanel>
            <Grid Margin="18,14,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:Glyph Data="{DynamicResource Icon.Search}" Width="20" Height="20" Foreground="{DynamicResource Brush.TextAccent}" />
                <TextBox x:Name="QueryBox" Grid.Column="1" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="18" Margin="6,0,0,0"
                         c:Hint.Placeholder="{DynamicResource Palette.Placeholder}" PreviewKeyDown="OnKey" AutomationProperties.AutomationId="PaletteQuery">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <TextBlock Text="{TemplateBinding c:Hint.Placeholder}" Foreground="{DynamicResource Brush.TextFaint}" VerticalAlignment="Center" Margin="2,0,0,0" x:Name="Placeholder" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
            </Grid>
            <Rectangle Style="{StaticResource Divider}" />
            <ListBox x:Name="Results" Style="{StaticResource List.Plain}" ItemContainerStyle="{StaticResource ListItem.Entry}" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}"
                     MaxHeight="430" Padding="0,6" MouseUp="OnResultClick" AutomationProperties.AutomationId="PaletteResults">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PaletteItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.Surface}">
                                <c:Glyph Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="16" Height="16" Foreground="{DynamicResource Brush.TextMuted}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock c:HighlightText.Text="{Binding Title}" c:HighlightText.Positions="{Binding Matches}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource Kbd}" VerticalAlignment="Center" Visibility="{Binding HasShortcut, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding Shortcut}" FontSize="11" Foreground="{DynamicResource Brush.TextFaint}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{DynamicResource Palette.Empty}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,22" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
            <Border Background="{DynamicResource Brush.Surface}" CornerRadius="0,0,18,18" Padding="16,9" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0">
                <WrapPanel>
                    <Border Style="{StaticResource Kbd}"><TextBlock Text="↑↓" FontSize="11" /></Border>
                    <TextBlock Text="{DynamicResource Palette.Navigate}" Style="{StaticResource Text.Caption}" Margin="4,0,12,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Kbd}"><TextBlock Text="Enter" FontSize="11" /></Border>
                    <TextBlock Text="{DynamicResource Palette.OpenAction}" Style="{StaticResource Text.Caption}" Margin="4,0,12,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Kbd}"><TextBlock Text="Ctrl+Enter" FontSize="11" /></Border>
                    <TextBlock Text="{DynamicResource Palette.CopyPassword}" Style="{StaticResource Text.Caption}" Margin="4,0,12,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Kbd}"><TextBlock Text="Alt+Enter" FontSize="11" /></Border>
                    <TextBlock Text="{DynamicResource Palette.CopyUser}" Style="{StaticResource Text.Caption}" Margin="4,0,12,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Kbd}"><TextBlock Text="Esc" FontSize="11" /></Border>
                    <TextBlock Text="{DynamicResource Palette.Close}" Style="{StaticResource Text.Caption}" Margin="4,0,0,0" VerticalAlignment="Center" />
                </WrapPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
