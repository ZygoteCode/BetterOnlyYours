<Window x:Class="OnlyYours.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:OnlyYours.App.Controls"
        xmlns:i="clr-namespace:OnlyYours.App.Infrastructure"
        xmlns:v="clr-namespace:OnlyYours.App.Views"
        xmlns:vm="clr-namespace:OnlyYours.App.ViewModels"
        Title="OnlyYours"
        Width="1280" Height="820" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}"
        FontSize="{StaticResource Size.Body}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        AutomationProperties.AutomationId="MainWindow">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <i:VisibleWhen x:Key="Visible" />
        <i:VisibleWhen x:Key="Hidden" Invert="True" />
        <i:IconConverter x:Key="Icon" />
        <i:ToastToneConverter x:Key="ToastTone" />
    </Window.Resources>

    <Grid x:Name="Root">
        <c:AmbientBackdrop />

        <c:TransitionHost x:Name="StageHost" Content="{Binding Stage}" Transition="{Binding StageTransition}" />

        <!-- ================================================= title bar -->
        <Grid x:Name="TitleBar" Height="44" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image Source="Assets/OnlyYours-256.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="ONLYYOURS" FontFamily="{StaticResource Font.Brand}" FontSize="13.5" FontWeight="SemiBold" Margin="10,1,0,0" Foreground="{DynamicResource Brush.TextAccent}" VerticalAlignment="Center" />
                <Rectangle Width="1" Height="14" Fill="{DynamicResource Brush.LineStrong}" Margin="12,1,12,0" Visibility="{Binding IsUnlocked, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding Shell.VaultName}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Visibility="{Binding IsUnlocked, Converter={StaticResource Visible}}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Command palette trigger -->
            <Button x:Name="PaletteTrigger" Grid.Column="1" HorizontalAlignment="Center" Width="420" Height="30" Margin="24,0"
                    WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand" Focusable="False"
                    Command="{Binding Shell.PaletteCommand}" Visibility="{Binding IsUnlocked, Converter={StaticResource Visible}}"
                    AutomationProperties.AutomationId="PaletteTrigger">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="9" Background="{DynamicResource Brush.Input}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" Padding="12,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <c:Glyph Data="{DynamicResource Icon.Search}" Width="14" Height="14" Foreground="{DynamicResource Brush.TextFaint}" />
                                    <TextBlock Text="{DynamicResource Title.Search}" Margin="10,0,0,0" Foreground="{DynamicResource Brush.TextFaint}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Style="{StaticResource Kbd}"><TextBlock Text="Ctrl" FontSize="10.5" Foreground="{DynamicResource Brush.TextFaint}" /></Border>
                                    <Border Style="{StaticResource Kbd}"><TextBlock Text="K" FontSize="10.5" Foreground="{DynamicResource Brush.TextFaint}" /></Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Brush.AccentLine}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Grid.Column="2" Style="{StaticResource Button.Ghost}" c:Hint.Icon="{DynamicResource Icon.Lock}" Content="{DynamicResource Title.Lock}"
                    Margin="0,0,8,0" Height="30" MinHeight="30" WindowChrome.IsHitTestVisibleInChrome="True" Focusable="False"
                    Command="{Binding Shell.LockCommand}" Visibility="{Binding IsUnlocked, Converter={StaticResource Visible}}"
                    ToolTip="Ctrl+L" AutomationProperties.AutomationId="LockButton" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="MinimizeButton" Style="{StaticResource Button.Caption}" c:Hint.Icon="{DynamicResource Icon.WinMinimize}" Click="OnMinimize" AutomationProperties.Name="Minimize" />
                <Button x:Name="MaximizeButton" Style="{StaticResource Button.Caption}" c:Hint.Icon="{DynamicResource Icon.WinMaximize}" Click="OnMaximize" AutomationProperties.Name="Maximize" />
                <Button x:Name="CloseButton" Style="{StaticResource Button.Close}" c:Hint.Icon="{DynamicResource Icon.Close}" Click="OnClose" AutomationProperties.Name="Close" AutomationProperties.AutomationId="CloseButton" />
            </StackPanel>
        </Grid>

        <!-- ============================================ command palette -->
        <Grid x:Name="PaletteLayer" Visibility="{Binding HasPalette, Converter={StaticResource Visible}}">
            <Rectangle Fill="{DynamicResource Brush.Scrim}" MouseDown="OnPaletteScrim" />
            <ContentControl Content="{Binding Palette}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,92,0,0" Focusable="False" />
        </Grid>

        <!-- ==================================================== dialogs -->
        <ItemsControl x:Name="DialogLayer" ItemsSource="{Binding Dialogs}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <v:DialogHost />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===================================================== toasts -->
        <ItemsControl x:Name="ToastLayer" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,40" Focusable="False" Width="380">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ToastViewModel}">
                    <Border CornerRadius="14" Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.LineStrong}" BorderThickness="1" Margin="0,8,0,0" Padding="14,12" c:Anim.Enter="Right">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity="0.45" Color="{DynamicResource Color.Shadow}" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="9" Background="{Binding Kind, Converter={StaticResource ToastTone}}" Opacity="0.16" VerticalAlignment="Top" />
                            <c:Glyph Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="16" Height="16" Foreground="{Binding Kind, Converter={StaticResource ToastTone}}" VerticalAlignment="Top" Margin="7" />
                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" FontSize="{StaticResource Size.Small}" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource Button.Link}" Content="{Binding ActionText}" Command="{Binding ActionCommand}" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{Binding HasAction, Converter={StaticResource Visible}}" />
                            <Button Grid.Column="3" Style="{StaticResource Button.Icon}" Width="26" Height="26" c:Hint.Icon="{DynamicResource Icon.Close}" Command="{Binding DismissCommand}" VerticalAlignment="Top" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ================================================ intro overlay -->
        <!-- The opening sequence is built only when it plays: no cost when it is off. -->
        <ContentControl x:Name="IntroHost" Focusable="False" IsTabStop="False" />
    </Grid>
</Window>
