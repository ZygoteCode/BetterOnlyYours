<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RootNamespace>OnlyYours.Core</RootNamespace>
    <AssemblyName>OnlyYours.Core</AssemblyName>
    <IsTrimmable>false</IsTrimmable>
    <TieredPGO>true</TieredPGO>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OnlyYours.Core.Tests" />
    <InternalsVisibleTo Include="OnlyYours.App" />
    <InternalsVisibleTo Include="OnlyYours.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Generators\Words\*.txt" />
    <EmbeddedResource Include="Analysis\common-passwords.txt" />
  </ItemGroup>

</Project>
